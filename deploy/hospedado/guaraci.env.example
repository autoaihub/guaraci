# Configuração do Guaraci hospedado. Copie para ~/guaraci.env, preencha e
# deixe só o dono lendo: chmod 600 ~/guaraci.env
# Este arquivo de exemplo não leva segredo; o de verdade nunca vai para o git.

GUARACI_MODE=hosted

# Segredo das sessões e dos links de download (mínimo 32 caracteres).
# O instalar.sh gera um com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GUARACI_SECRET_KEY=

# Onde ficam os arquivos das coletas (um subdiretório por usuário e por coleta)
# e o banco de contas e registros.
GUARACI_OUTPUT_ROOT=/home/sabia/guaraci-dados/saidas
GUARACI_DB_PATH=/home/sabia/guaraci-dados/estado/guaraci.db
GUARACI_DATA_ROOT=/home/sabia/guaraci-dados/cache

# Endereço público, usado para conferir a origem das requisições.
GUARACI_PUBLIC_ORIGIN=https://guaraci.sabiadatalake.com.br
# Contato para pedidos de titulares (LGPD), mostrado em /privacidade.
GUARACI_CONTACT=

# IP do proxy reverso. Só dele o Guaraci aceita X-Forwarded-For; sem isso,
# todo acesso apareceria com o IP do proxy e o limite por IP valeria para todos.
GUARACI_PROXY_IP=
GUARACI_PORT=8080

# Cookie só por HTTPS (deixe true: o TLS termina no proxy).
GUARACI_COOKIE_SECURE=true
GUARACI_SESSION_TTL_HOURS=12

# Fila. Com 2 vCPU e 4 GB de RAM, duas coletas ao mesmo tempo é o teto prudente.
GUARACI_MAX_RUNNING=2
GUARACI_MAX_RUNNING_PER_USER=1
GUARACI_MAX_ACTIVE_PER_USER=3
GUARACI_MAX_JOBS_PER_DAY=10
GUARACI_MAX_ACTIVE_GLOBAL=40
GUARACI_MAX_JOB_GB=2
GUARACI_MAX_JOB_MINUTES=120
GUARACI_MIN_FREE_DISK_GB=5
GUARACI_OUTPUT_TTL_HOURS=48

# Limites de requisição.
GUARACI_RATE_IP_PER_MINUTE=120
GUARACI_RATE_AUTH_PER_MINUTE=10
GUARACI_RATE_SIGNUP_PER_HOUR=5
GUARACI_RATE_DISCOVERY_PER_HOUR=30
GUARACI_RATE_JOBS_PER_HOUR=30

# LGPD: IP completo por 30 dias, registro de uso por 365.
GUARACI_IP_RETENTION_DAYS=30
GUARACI_EVENT_RETENTION_DAYS=365
GUARACI_JANITOR_SECONDS=900
